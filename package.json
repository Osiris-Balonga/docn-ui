{
  "name": "docn-ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Emmanuel Osiris Balonga",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "pnpm generate:templates && pnpm generate:registry && pnpm --filter @docn-ui/www dev",
    "build": "corepack pnpm@11.24.0 generate:templates && corepack pnpm@11.24.0 generate:registry && corepack pnpm@11.24.0 --filter @docn-ui/www build && node tooling/testing/build-fingerprint.mjs write",
    "build:preview": "node tooling/deployment/build-preview.mjs",
    "generate:templates": "node tooling/templates/generate.mjs",
    "verify:templates": "node tooling/templates/generate.mjs --check",
    "generate:registry": "node tooling/registry/generate.mjs",
    "verify:registry": "node tooling/registry/generate.mjs --check",
    "verify:assets": "node tooling/assets/verify-assets.mjs",
    "verify:docs": "node tooling/docs/verify-links.mjs",
    "generate:docs": "node tooling/docs/generate.mjs",
    "preview": "node tooling/testing/serve-static.mjs apps/www/out 127.0.0.1 4173",
    "preview:verify": "node tooling/deployment/verify-preview.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,yml,yaml,css}\"",
    "lint": "eslint . --max-warnings 0",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "vitest run --project unit --project components",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:pdf": "vitest run --project pdf",
    "test:consumers": "pnpm generate:registry && vitest run --project consumers",
    "test:e2e": "playwright test",
    "test:visual": "vitest run --project visual",
    "test:watch": "vitest --project unit --project components",
    "test:coverage": "vitest run --project unit --project components --coverage",
    "test:all": "node tooling/testing/run-all.mjs",
    "validate": "pnpm quality && pnpm test",
    "validate:full": "pnpm quality && pnpm build && pnpm test:all"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "@zxing/library": "0.23.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.2.108",
    "prettier": "3.9.6",
    "shadcn": "4.19.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
