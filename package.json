{
  "name": "docn-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "pnpm --filter @docn-ui/www dev",
    "build": "pnpm --filter @docn-ui/www build",
    "preview": "http-server apps/www/out -a 127.0.0.1 -p 4173 -c-1",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,yml,yaml,css}\"",
    "lint": "eslint . --max-warnings 0",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "vitest run --project unit --project components --project integration",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run --project integration",
    "test:pdf": "vitest run --project pdf",
    "test:watch": "vitest --project unit --project components --project integration",
    "test:coverage": "vitest run --project unit --project components --project integration --coverage",
    "test:all": "node tooling/testing/run-all.mjs",
    "validate": "pnpm quality && pnpm test",
    "validate:full": "pnpm quality && pnpm build && pnpm test:all"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
